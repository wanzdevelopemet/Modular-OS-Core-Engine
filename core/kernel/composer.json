{
  "name": "modular-os/kernel",
  "type": "project",
  "description": "Modular-OS Microkernel Core Engine (Laravel 11)",
  "keywords": [
    "microkernel",
    "laravel",
    "zero-trust",
    "anti-mesh",
    "event-bus"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "firebase/php-jwt": "^6.10",
    "laravel/framework": "^11.0",
    "laravel/octane": "^2.22",
    "predis/predis": "^2.2",
    "spiral/roadrunner-cli": "^2.6.0",
    "spiral/roadrunner-http": "^3.3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Extensions\\Cams\\": "core/extensions/cams/src/",
      "Extensions\\NotificationCenter\\": "core/extensions/notification-center/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "policy": {
      "advisories": {
        "block": false
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
