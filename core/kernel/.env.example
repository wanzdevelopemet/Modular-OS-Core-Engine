APP_NAME="Modular-OS Kernel"
APP_ENV=production
APP_KEY=
# APP_DEBUG must remain false in production environments to avoid leaking sensitive stack traces and secrets
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=modular_os_db
DB_USERNAME=modular_user
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=predis
REDIS_HOST=redis-broker
REDIS_PASSWORD=
REDIS_PORT=6379

JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost

# CAMS Super Admin bootstrap setting (Disable in production!)
CAMS_SUPERADMIN_ENABLED=false
CAMS_SUPERADMIN_PASSWORD=
